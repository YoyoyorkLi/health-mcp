/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse-coach-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  /**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 *
	 * Commands to set secrets (see .dev.vars.example for the full list):
	 * npx wrangler secret put GITHUB_CLIENT_ID
	 * npx wrangler secret put GITHUB_CLIENT_SECRET
	 * npx wrangler secret put COOKIE_ENCRYPTION_KEY
	 * npx wrangler secret put ALLOWED_GITHUB_LOGIN
	 * npx wrangler secret put SUPABASE_URL
	 * npx wrangler secret put SUPABASE_ANON_KEY
	 * npx wrangler secret put SUPABASE_COACH_EMAIL
	 * npx wrangler secret put SUPABASE_COACH_PASSWORD
	 */
  "migrations": [
    {
      "new_sqlite_classes": ["PulseCoachMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "PulseCoachMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "75c8c75156834baf961339bbcffba093"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
